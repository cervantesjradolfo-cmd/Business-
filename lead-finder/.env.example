# Optional. Enables AI-written pitches (templates are used when empty).
ANTHROPIC_API_KEY=
# Set this to your own e-mail. It is sent to OpenStreetMap servers (they ask for a real contact).
# Leave it unset only if you must: no e-mail is sent then, and OpenStreetMap may refuse searches.
LEADS_CONTACT_EMAIL=
# Optional but recommended for a public deploy (also consider Vercel Deployment Protection).
# When set, every API call needs a matching x-access-key header; enter it in the app under "Your details".
APP_ACCESS_KEY=
# Optional. Comma-separated Overpass API URLs to query in parallel instead of the built-in public mirrors.
# https only, public hosts only, up to 6 (localhost, private/LAN and credentialed URLs are ignored).
OVERPASS_URLS=
